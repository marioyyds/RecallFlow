{
  "manifest_version": 3,
  "name": "RecallFlow",
  "version": "0.0.1",
  "description": "RecallFlow：浏览器里的统一 AI 助手——在任意网页上划词即问，让 AI 替你读、操作并记忆，支持基于知识库的 RAG 检索问答。",
  "permissions": ["tabs", "storage", "contextMenus", "scripting", "notifications", "alarms", "debugger"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RecallFlow",
    "default_icon": {
      "16": "docs/assets/recallflow-mark.svg",
      "32": "docs/assets/recallflow-mark.svg",
      "48": "docs/assets/recallflow-mark.svg",
      "128": "docs/assets/recallflow-mark.svg"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/page/debug-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/**/*.js"],
      "matches": ["http://*/*", "https://*/*"]
    },
    {
      "resources": ["docs/assets/recallflow-mark.svg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "docs/assets/recallflow-mark.svg",
    "32": "docs/assets/recallflow-mark.svg",
    "48": "docs/assets/recallflow-mark.svg",
    "128": "docs/assets/recallflow-mark.svg"
  }
}
