{
  "name": "recallflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "RecallFlow browser extension (MV3).",
  "scripts": {
    "test:unit": "node --test \"tests/*.test.mjs\" \"integrations/opencode/recallflow-mcp/test/*.test.mjs\"",
    "test:cov": "node scripts/coverage-baseline.mjs --print",
    "test:cov:write": "node scripts/coverage-baseline.mjs",
    "test:watch": "node --test --watch \"tests/*.test.mjs\" \"integrations/opencode/recallflow-mcp/test/*.test.mjs\"",
    "check:const": "node scripts/check-const-assign.mjs",
    "check:prefix": "node scripts/check-prefix-stability.mjs",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:mutation": "node scripts/mutation-check.mjs",
    "check:types": "tsc --noEmit",
    "build:content": "node scripts/build-content.mjs",
    "build:entries": "node scripts/build-entries.mjs",
    "test": "node scripts/run-all-checks.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "render:icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
