{
  "name": "dsh-client-recallflow-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把浏览器 RecallFlow 面板的对话渲染在 DSH 界面里（不冒充用户消息）",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
